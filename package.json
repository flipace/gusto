{
    "name": "gusto-chef",
    "version": "1.0.0",
    "description": "Gusto Chef - Private Chef Booking Platform",
    "main": "source/app/index.html",
    "scripts": {
        "start": "php -S localhost:8000 -t source",
        "build:ios": "npx cap add ios && npx cap sync ios",
        "build:android": "npx cap add android && npx cap sync android",
        "open:ios": "npx cap open ios",
        "open:android": "npx cap open android",
        "sync": "npx cap sync"
    },
    "keywords": [
        "chef",
        "booking",
        "food",
        "private-chef",
        "uber-for-chefs"
    ],
    "author": "Gusto Chef",
    "license": "MIT",
    "dependencies": {
        "@capacitor/android": "^5.0.0",
        "@capacitor/core": "^5.0.0",
        "@capacitor/ios": "^5.0.0",
        "@capacitor/keyboard": "^5.0.0",
        "@capacitor/push-notifications": "^5.0.0",
        "@capacitor/splash-screen": "^5.0.0",
        "@capacitor/status-bar": "^5.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^5.0.0"
    }
}
